snippet pe_ "power equation" A
\$ P_{ \mathrm{$1} } = \qty{$2}{\dBm} \$ $0
endsnippet

context math(context)
snippet pe_ "power equation" A
P_{ \mathrm{$1} } = \qty{$2}{\dBm} $0
endsnippet


context math(context)
snippet cos "cos" Ai
\cos\left( $0 \right)
endsnippet

context math(context)
snippet sin "sin" Ai
\sin\left( $0 \right)
endsnippet

snippet beq "equation" Ab
\begin{equation}\label{eq:${1:label}}
$0
\end{equation}
endsnippet

snippet baeq "equation with array" Ab
\begin{equation}\label{eq:${1:label}}
$0 \\\\
\end{equation}
endsnippet

context math(context)
snippet `lr(\(\)|\[\]|\{\}|\.|<|\||2\|)` "Inserts left-right braces" A
\\left``let c = m[1];
if (c.length == 2){
d = c.split('');
rv = d[0];}
else
{rv = m[1]}
`` $0 \\right``if (c.length == 2){rv = d[1];}else{rv = m[1]}``
endsnippet

snippet figw "Inserts a figure with width reference" Ab
\begin{figure}[htbp]
\centering
\includegraphics[width=\textwidth]{figures/$1}
\caption{${2:Caption}}
\label{fig:${3:figLabel}}
\end{figure}
endsnippet

snippet figs "Inserts a figure with scale reference" Ab
\begin{figure}[htbp]
\centering
\includegraphics[scale = 1]{figures/$1}
\caption{${2:Caption}}
\label{fig:${3:figLabel}}
\end{figure}
endsnippet

snippet figc "Inserts a figure with column width" Ab
\begin{figure}[htbp]
\centering
\includegraphics[width=\columnwidth]{figures/$1}
\caption{${2:Caption}}
\label{fig:${3:figLabel}}
\end{figure}
endsnippet

snippet fig2c "Inserts a figure with full width in two columns template" Ab
\begin{figure*}[htbp]
\centering
\includegraphics[width=\textwidth]{figures/$1}
\caption{${2:Caption}}
\label{fig:${3:figLabel}}
\end{figure*}
endsnippet

snippet ref "Random reference"
\ref{${1:label}}
endsnippet

snippet cit "Cite" A
\cite{${1:citeKey}}
endsnippet

snippet mrm "Math Roman" Ai
\mathrm{$1}$0
endsnippet

context math(context)
snippet fr "Fraction" Ai
\frac{${1:${TM_SELECTED_TEXT:nm}}}{${2:dn}}
endsnippet

context math(context)
snippet dfr "Display fraction" A
\dfrac{${1:nm} }{ ${2:dm}}
endsnippet

snippet `([a-z]{2,});;` "LaTeX Glossary Entry" A
\gls{``rv = m[1]``}
endsnippet

# snippet `([a-z]{2,5})\s` "Automatic \gls{} lookup" Ab
snippet `(?:^|[\s(),.:;])([a-z]{2,5})([\s,.:;])` "Automatic \gls{} lookup with punctuation" A
``
const validWords = new Set([
  "arof", "drof", "rof", "im", "dd", "ngn", "pfc", "ofc", "dl", "ul", "lo", "elo", "olo", "mzm", "iqmzm", "npmzm", "np", 
  "mmw", "udc", "ran", "fg", "ofh", "xh", "pon", "dml", "uc", "dc", "rrh", "co", "bbu", "cu", "du", "ru", "edfa", "rf", 
  "if", "ocsr", "ber", "evm", "qam", "smf", "b2b", "pd", "er", "bw", "lna", "pa", "awg", "aawg", "cw", "adc", "dac", 
  "capex", "opex", "comp", "ptp", "ptmp", "dipp", "wdm", "dwdm", "udwdm", "dm", "dsb", "ssb", "dsp", "cd", "dsm", "eopt", 
  "opte", "cpri", "ecpri", "ifof", "il", "los", "mimo", "onu", "olt", "paa", "qos", "rf", "roadm", "wss", "scm", "sdm", "snr", 
  "tdm", "ue", "fs", "oran", "cran", "frstg", "sg", "tg" ,"cg", "ai", "kpi", "eom"
]);

const word = m[1];
const trailingPunct = m[2];

if (validWords.has(word)) {
  rv = ` \\gls{${word}}${trailingPunct}`;
} else {
  // If not found in the list, keep the original typed string intact
  rv = ` ${word}${trailingPunct}`;
}
``
endsnippet

snippet nacr "New glossary entry"
\newacronym{${1:acronym-label}}{${2:EAT}}{${3:Extended Acronym Text}}$0
endsnippet

snippet tst "Test"
Test\n
endsnippet

##############################################################################
# quantity (siunitx)
##############################################################################

snippet qty "siunitx input" A
\qty{${1:number}}{\\${2:dimension}}
endsnippet

snippet `(-?\d+(?:\.\d+)?)(\s?[a-zA-Z]+)` "quantity from data"
\qty{``rv = m[1];``}{\\``
let a = m[2];
rv = a.replace(/ /g, '');
``$1}$0
endsnippet

snippet \u "siunitx unit" Ai
\unit{\\${1:unit}}$0
endsnippet

##############################################################################
# Super- and Sub- scripts
##############################################################################

context math(context)
snippet `([ ]*)sp` "superscript" Ai
^{$1}$0
endsnippet

context math(context)
snippet pi "pi" Ai
\\pi $0
endsnippet

context math(context)
snippet ^ "power" Ai
^{$1} $0
endsnippet

context math(context)
snippet `([a-zA-Z])sb` "subscript nought" A
``rv = m[1]``_{\mathrm{$0}}
endsnippet

context math(context)
snippet _ "underscore" Ai
_{$1}$0
endsnippet

context math(context)
snippet vec "underscore" Ai
\vec{$1} $0
endsnippet

##############################################################################
# Sections and subsections etc
##############################################################################
context notmath(context)
snippet sec "Section" Ab
\section{${1:${VISUAL:Section title}}}
endsnippet

context notmath(context)
snippet ssc "sub Section" Ab
\subsection{${1:${VISUAL:Section title}}}
endsnippet

context notmath(context)
snippet sss "sub sub Section" Ab
\subsubsection{${1:${VISUAL:Section title}}}
endsnippet

##############################################################################
# Figures and tables
##############################################################################

snippet tab "Inserts a table" A
\begin{table}[htbp]
\centering
\caption{${1:Caption}}

\begin{tblr}{
    width = \textwidth,
    colspec = {|X[1,c]|X[1,c]|},
    row{1} = {fg=white, bg=NavyBlue} % To color header
}
\hline
No. & \textbf{Title} \\\\
\hline
No. & \textbf{Title} \\\\
\hline
\end{tblr}
\label{tab:${2:tabLabel}}
\end{table}
endsnippet

snippet note_template "Basic article template"
\documentclass[a4paper,12pt]{article}
\usepackage{standard_preamble}

\title{${1: Title}}
\author{${2: Rodrigo}}
\date{\today}

\begin{document}
\maketitle
$0
\end{document}
endsnippet

