global
function math(context) {
    return context.scopes.some(s => s.startsWith("meta.math"));
}

function notmath(context) {
    return  context.scopes.findLastIndex(s => s.startsWith("meta.math")) <= context.scopes.findLastIndex(s => s.startsWith("comment") || s.startsWith("meta.text.normal.tex"));
}
endglobal

snippet refse "References a section" Ai
Section \ref{sec:${1:sec-title}}$0
endsnippet

snippet reff "References a Figure" Ai
Fig.~\ref{fig:${1:label}}
endsnippet

snippet // "Fraction simple" Ai
\dfrac{$1}{$2} $0
endsnippet

snippet reft "References a table" Ai
Table \ref{tab:${1:label}}
endsnippet

snippet refeq "References an equation" Ai
\\eqref{eq:${1:label}}
endsnippet

snippet refsf "References a Figure inset" Ai
Fig.~\ref{fig:${1:label}}(${2:inset})
endsnippet

context notmath(context)
snippet leq "Inline equation" Ai
\$ $1 \$$0
endsnippet

context notmath(context)
snippet deq "display equation" Ai
\[ $1 \] $0
endsnippet

context notmath(context)
snippet fe_ "freq equation" Ai
\$ f_{\mathrm{$1}} = \qty{$2}{\GHz} \$ $0
endsnippet

context math(context)
snippet fe_ "freq equation" Ai
f_{\mathrm{$1}} = \qty{$2}{\GHz} $0
endsnippet

context notmath(context)
snippet f_ "freq subindex" A
\$ f_{\mathrm{$1}} \$ $0
endsnippet

context math(context)
snippet f_ "freq subindex" Ai
f_{\mathrm{$1}} $0
endsnippet

